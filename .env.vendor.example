# ── Vendor border-tax agent instance ─────────────────────────────────────────
# A DEDICATED suvidha deployment pointed at the vendor-panel Firebase project.
# Copy to `.env` for THIS instance. The existing CabsWale instance keeps its own
# .env (unchanged: driverUtilitiesRequests/... path, its own bucket/SA).

# Redis (compose default).
REDIS_URL=redis://redis-pivot:6379

# Vendor-panel Firestore: the flat top-level collection the panel + functions use.
REQUEST_DOC_PATH_TEMPLATE=borderTaxRequests/{requestId}

# Vendor-panel Cloud Storage (the new project's bucket) + a clean prefix.
GCS_BUCKET=your-project-id.firebasestorage.app
GCS_PREFIX=borderTaxRequests

# Service account JSON for the NEW project, mounted into the api container.
# (compose mounts ${SERVICE_ACCOUNT_FILE} -> /secrets/service.json)
SERVICE_ACCOUNT_FILE=./service.vendor.json

# Worker -> /api/internal/* shared secret (private network). Set on the worker too.
INTERNAL_API_KEY=change-me-internal-secret

# Guard for the PUBLIC mutating routes (/api/run, /api/verify-pending,
# /api/jobs/:id/intervene|cancel) — this instance is reachable from the panel's
# Cloud Functions over HTTPS. MUST equal the panel functions' INTERNAL_API_KEY
# secret (they send it as the X-Internal-Key header).
PUBLIC_API_KEY=change-me-must-match-panel-functions-INTERNAL_API_KEY

# Optional tuning (sensible defaults already apply):
# QR_VALIDITY_DAYS=7
# CAPTCHA_URL_TTL_SECONDS=600
